NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/smart-attendance
JWT_SECRET=your_super_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_here_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Smart Attendance <noreply@example.com>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=5
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_BULK=10

# CORS
CORS_ORIGIN=http://localhost:3000

# Client URL (for email links)
CLIENT_URL=http://localhost:3000

# Attendance Reminder Scheduler
ENABLE_ATTENDANCE_REMINDER=true
REMINDER_CRON="* * * * *"
REMINDER_THRESHOLD=75
REMINDER_BATCH_SIZE=50
REMINDER_COOLDOWN_DAYS=14
